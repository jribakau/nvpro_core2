#ifndef HDR_ENV_SAMPLING_GLSL
#define HDR_ENV_SAMPLING_GLSL 1


#include "functions.h.slang"  // getSphericalUv
#include "hdr_io.h.slang"

/*-------------------------------------------------------------------------------------------------
# Function `environmentSampleCoords`
> Shared alias-method sampling: picks a cell of the sampling grid and computes both the UV for the
> texture lookup and the sampled light direction, uniform in solid angle within the cell. Used by
> the `environmentSample` overloads so the sampling math lives in one place.

Inputs:
- `envSamplingData`, the alias table `nvvk::HdrIbl` builds, one entry per grid cell.
- randVal: A uniform random vector in the range [0,1]^3.
- width, height: Dimensions of the sampling grid -- `HdrIbl::getSamplingGrid()`. For an
  environment loaded from a file that is the image size; a GPU-baked one may use a coarser grid.

Returns the UV to look up, and sets `toLight` to the sampled direction.

See https://arxiv.org/pdf/1901.05423.pdf, Section 2.6, "The Alias Method".
-------------------------------------------------------------------------------------------------*/
float2 environmentSampleCoords(in StructuredBuffer<EnvAccel> envSamplingData, in float3 randVal, uint width, uint height, out float3 toLight)
{
  // Uniformly pick a texel index idx in the environment map
  float3 xi = randVal;

  uint size = width * height;
  uint idx  = min(uint(xi.x * float(size)), size - 1U);

  // Fetch the sampling data for that texel, containing the ratio q between its
  // emitted radiance and the average of the environment map, the texel alias,
  // the probability distribution function (PDF) values for that texel and its
  // alias
  EnvAccel sample_data = envSamplingData[idx];

  uint env_idx;

  if(xi.y < sample_data.q)
  {
    // If the random variable is lower than the intensity ratio q, we directly pick
    // this texel, and renormalize the random variable for later use. The PDF is the
    // one of the texel itself
    env_idx = idx;
    xi.y /= sample_data.q;
  }
  else
  {
    // Otherwise we pick the alias of the texel, renormalize the random variable and use
    // the PDF of the alias
    env_idx = sample_data.alias;
    xi.y    = (xi.y - sample_data.q) / (1.0f - sample_data.q);
  }

  return environmentCellCoords(env_idx, xi.yz, width, height, toLight);
}

/*-------------------------------------------------------------------------------------------------
# Function `environmentCellCoords`
> A direction uniform in solid angle within grid cell `cellIdx`, from two uniforms `xi`, and the UV
> to look it up at: the part of the alias method that follows the pick of the cell.
-------------------------------------------------------------------------------------------------*/
float2 environmentCellCoords(uint cellIdx, float2 xi, uint width, uint height, out float3 toLight)
{
  // Compute the 2D integer coordinates of the texel
  const uint px = cellIdx % width;
  uint       py = cellIdx / width;

  // Uniformly sample the solid angle subtended by the pixel.
  // Generate both the UV for texture lookup and a direction in spherical coordinates
  const float u       = float(px + xi.x) / float(width);
  const float phi     = u * (2.0f * M_PI) - M_PI;
  float       sin_phi = sin(phi);
  float       cos_phi = cos(phi);

  const float step_theta = M_PI / float(height);
  const float theta0     = float(py) * step_theta;
  const float cos_theta  = cos(theta0) * (1.0f - xi.y) + cos(theta0 + step_theta) * xi.y;
  const float theta      = acos(cos_theta);
  const float sin_theta  = sin(theta);
  const float v          = theta * M_1_OVER_PI;

  // Convert to a light direction vector in Cartesian coordinates
  toLight = float3(cos_phi * sin_theta, cos_theta, sin_phi * sin_theta);

  return float2(u, v);
}

/*-------------------------------------------------------------------------------------------------
# Function `environmentSample`
> Randomly samples a direction from an environment map.

Inputs:
- `envSamplingData`, a buffer generated by the `HdrEnvDome` code containing
data for the alias method to work.
- hdrTexture: Used to look up the environment value.
- randVal: A uniform random vector in the range [0,1]^3.

Returns `vec4(float3(radiance), pdf)`, and sets `toLight` to the
sampled direction.

See https://arxiv.org/pdf/1901.05423.pdf, Section 2.6, "The Alias Method".
-------------------------------------------------------------------------------------------------*/
float4 environmentSample(in Sampler2D hdrTexture, in StructuredBuffer<EnvAccel> envSamplingData, in uint2 samplingGrid, in float3 randVal, out float3 toLight)
{
  const float2 uv = environmentSampleCoords(envSamplingData, randVal, samplingGrid.x, samplingGrid.y, toLight);

  // Lookup the environment value using bilinear filtering. The alpha is the PDF of the cell the
  // direction lies in -- see env_write_pdf.slang.
  return hdrTexture.SampleLevel(uv, 0.0f);
}

// Same, for a sampling grid equal to the image -- every file-loaded environment. A GPU-baked one
// may be sampled on a coarser grid, and must use the overload above with getSamplingGrid().
float4 environmentSample(in Sampler2D hdrTexture, in StructuredBuffer<EnvAccel> envSamplingData, in float3 randVal, out float3 toLight)
{
  uint2 tsize;
  hdrTexture.GetDimensions(tsize.x, tsize.y);
  return environmentSample(hdrTexture, envSamplingData, tsize, randVal, toLight);
}

/*-------------------------------------------------------------------------------------------------
# Function `environmentSample` (separate texture + sampler)
> Same as above but takes a decoupled `Texture2D` + `SamplerState` instead of a combined
> `Sampler2D`. Required for bindless descriptor-heap shaders, where images and samplers live in
> separate heaps and are obtained via `Texture2D.Handle(...)` / `SamplerState.Handle(...)`.
-------------------------------------------------------------------------------------------------*/
float4 environmentSample(in Texture2D                 hdrTexture,
                         in SamplerState              hdrSampler,
                         in StructuredBuffer<EnvAccel> envSamplingData,
                         in uint2                     samplingGrid,
                         in float3                    randVal,
                         out float3                   toLight)
{
  const float2 uv = environmentSampleCoords(envSamplingData, randVal, samplingGrid.x, samplingGrid.y, toLight);

  return hdrTexture.SampleLevel(hdrSampler, uv, 0.0f);
}

// Same, for a sampling grid equal to the image.
float4 environmentSample(in Texture2D                 hdrTexture,
                         in SamplerState              hdrSampler,
                         in StructuredBuffer<EnvAccel> envSamplingData,
                         in float3                    randVal,
                         out float3                   toLight)
{
  uint2 tsize;
  hdrTexture.GetDimensions(tsize.x, tsize.y);
  return environmentSample(hdrTexture, hdrSampler, envSamplingData, tsize, randVal, toLight);
}

/*-------------------------------------------------------------------------------------------------
# Function `environmentSampleCompensated`
> A direction from the MIS-compensated table (`EnvCompensatedCell`, `nvvk::buildCompensatedEnvAliasmap`):
> for a light sample that a BSDF sample of the same point is weighed against.

Returns the radiance looked up as `environmentSample` does (bilinear), and sets `toLight` and `pdf`,
the cell's solid-angle pdf under this table.
-------------------------------------------------------------------------------------------------*/
float3 environmentSampleCompensated(in Sampler2D                           hdrTexture,
                                    in StructuredBuffer<EnvCompensatedCell> cells,
                                    in uint2                                samplingGrid,
                                    in float3                               randVal,
                                    out float3                              toLight,
                                    out float                               pdf)
{
  const uint size = samplingGrid.x * samplingGrid.y;
  const uint idx  = min(uint(randVal.x * float(size)), size - 1U);

  const EnvCompensatedCell entry = cells[idx];
  uint                     cell;
  float                    xiY = randVal.y;
  if(xiY < entry.q)
  {
    cell = idx;
    xiY /= entry.q;
  }
  else
  {
    cell = entry.alias;
    xiY  = (xiY - entry.q) / (1.0f - entry.q);
  }

  const float2 uv = environmentCellCoords(cell, float2(xiY, randVal.z), samplingGrid.x, samplingGrid.y, toLight);
  pdf             = cells[cell].pdf;
  return hdrTexture.SampleLevel(uv, 0.0f).rgb;
}

/*-------------------------------------------------------------------------------------------------
# Function `environmentSampleCompensatedStratified`
> `environmentSampleCompensated`'s distribution, by inverting the cumulative tables that follow it
> (EnvCompensatedCell::cdf): randVal.x picks the row, randVal.y the cell in it, and what is left of
> each places the direction in the cell. Monotonic in both, so a stratified point set (Sobol) stays
> stratified over the environment -- a soft box's or the sky's light samples spread over it as the
> points do -- where the alias method scatters neighbouring points. Binary searches: for the
> frames that accumulate a still. randVal.z is not used.
-------------------------------------------------------------------------------------------------*/
float3 environmentSampleCompensatedStratified(in Sampler2D                           hdrTexture,
                                              in StructuredBuffer<EnvCompensatedCell> cells,
                                              in uint2                                samplingGrid,
                                              in float3                               randVal,
                                              out float3                              toLight,
                                              out float                               pdf)
{
  const uint width = samplingGrid.x, height = samplingGrid.y;
  const uint rows  = width * height;  // the row marginal starts here

  // The first row whose marginal passes randVal.x
  uint lo = 0, hi = height - 1U;
  while(lo < hi)
  {
    const uint mid = (lo + hi) / 2U;
    if(cells[rows + mid].cdf > randVal.x)
      hi = mid;
    else
      lo = mid + 1U;
  }
  const uint  y      = lo;
  const float rowLo  = (y > 0U) ? cells[rows + y - 1U].cdf : 0.0f;
  const float rowHi  = cells[rows + y].cdf;
  const float yRest  = saturate((randVal.x - rowLo) / max(rowHi - rowLo, 1e-30f));

  // The first cell of that row whose conditional passes randVal.y
  const uint first = y * width;
  lo               = 0;
  hi               = width - 1U;
  while(lo < hi)
  {
    const uint mid = (lo + hi) / 2U;
    if(cells[first + mid].cdf > randVal.y)
      hi = mid;
    else
      lo = mid + 1U;
  }
  const uint  cell   = first + lo;
  const float cellLo = (lo > 0U) ? cells[cell - 1U].cdf : 0.0f;
  const float xRest  = saturate((randVal.y - cellLo) / max(cells[cell].cdf - cellLo, 1e-30f));

  const float2 uv = environmentCellCoords(cell, float2(xRest, yRest), width, height, toLight);
  pdf             = cells[cell].pdf;
  return hdrTexture.SampleLevel(uv, 0.0f).rgb;
}

/*-------------------------------------------------------------------------------------------------
# Function `environmentCompensatedPdf`
> The solid-angle pdf with which `environmentSampleCompensated` produces direction `dir` (in the
> environment's frame, as for a lat-long lookup): its cell's.
-------------------------------------------------------------------------------------------------*/
float environmentCompensatedPdf(in StructuredBuffer<EnvCompensatedCell> cells, in uint2 samplingGrid, in float3 dir)
{
  const float2 uv = getSphericalUv(dir);
  const uint   px = min(uint(max(uv.x, 0.0f) * float(samplingGrid.x)), samplingGrid.x - 1U);
  const uint   py = min(uint(max(uv.y, 0.0f) * float(samplingGrid.y)), samplingGrid.y - 1U);
  return cells[py * samplingGrid.x + px].pdf;
}

#endif  // ENV_SAMPLING_GLSL
